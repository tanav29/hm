// A simple contact form
main.min-h-screen.bg-slate-100.flex.items-center.justify-center.p-6 {
  section.w-full.max-w-lg.bg-white.rounded-2xl.shadow-lg.p-8 {
    h1.text-3xl.font-bold.text-slate-900 "Say hello"
    p.mt-2.text-slate-600 "Tell us what you are working on."
    form.mt-6.space-y-4[action="/contact"][method="post"] {
      div {
        label.block.text-sm.font-medium.text-slate-700[for="name"] "Name"
        input#name.mt-1.w-full.rounded-lg.border.border-slate-300.p-3[name="name"][type="text"][required="required"]
      }
      div {
        label.block.text-sm.font-medium.text-slate-700[for="email"] "Email"
        input#email.mt-1.w-full.rounded-lg.border.border-slate-300.p-3[name="email"][type="email"][required="required"]
      }
      div {
        label.block.text-sm.font-medium.text-slate-700[for="message"] "Message"
        textarea#message.mt-1.w-full.rounded-lg.border.border-slate-300.p-3[name="message"][rows="4"]
      }
      button.rounded-lg.bg-slate-900.px-5.py-3.text-white.hover:bg-slate-700[type="submit"] "Send message"
    }
  }
}
