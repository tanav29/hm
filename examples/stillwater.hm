// A visual travel journal: nested layouts, arbitrary values and escaped attributes.
title "Stillwater"
main.bg-[#e8edf0].text-[#17343b].min-h-screen {
  header.mx-auto.max-w-[1440px].px-6.md:px-12.py-6.flex.items-center.justify-between {
    a.font-serif.text-2xl.font-bold.tracking-tight$"#home" "stillwater"
    nav.flex.items-center.gap-6.text-sm.font-medium[aria-label="Main navigation"] {
      a.hover:underline$"#places" "The coast"
      a.hover:underline$"#journal" "Journal"
      a.hidden.md:block.rounded-full.border.border-[#17343b].px-5.py-2.hover:bg-[#17343b].hover:text-white$"#visit" "Plan a visit"
    }
  }
  section#home.mx-auto.max-w-[1440px].px-4.md:px-8 {
    div.relative.min-h-[620px].md:min-h-[700px].overflow-hidden.rounded-[1.5rem].bg-[#587b83] {
      img.absolute.inset-0.h-full.w-full.object-cover%"https://images.unsplash.com/photo-1473116763249-2faaef81ccda?auto=format&fit=crop&w=2400&q=85"&"Rocky coastline meeting the sea"
      div.absolute.inset-0.bg-gradient-to-r.from-[#092c35]/80.via-[#092c35]/35.to-transparent
      div.relative.flex.min-h-[620px].md:min-h-[700px].flex-col.justify-end.p-8.md:p-16.text-white {
        p.text-sm.tracking-[0.2em] "A field guide to the slower side of the sea"
        h1.mt-6.max-w-3xl.font-serif.text-6xl.md:text-8xl.leading-[0.95].tracking-tight "Find your own\nshoreline."
        p.mt-7.max-w-md.text-lg.leading-relaxed.text-white/90 "Salt air, quiet paths, and places worth taking the long way to reach."
        a.mt-8.w-fit.rounded-full.bg-white.px-6.py-4.text-sm.font-semibold.text-[#17343b].hover:bg-[#dcebed]$"#places" "Explore the coast"
      }
    }
  }
  section#places.mx-auto.max-w-7xl.px-6.md:px-12.py-20.md:py-28 {
    div.grid.gap-8.md:grid-cols-2.md:items-end {
      h2.max-w-xl.font-serif.text-5xl.md:text-6xl.leading-tight "A little further from the everyday."
      p.max-w-md.text-lg.leading-relaxed.text-[#49636a] "Follow the water to sheltered coves, wind-shaped trails and small towns with room to breathe."
    }
    div.mt-12.grid.gap-8.md:grid-cols-12.md:items-start {
      article.md:col-span-7 {
        img.aspect-[4/3].w-full.rounded-[1rem].object-cover%"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=1400&q=85"&"Ocean waves rolling towards the shore"
        div.mt-5.flex.justify-between.gap-4 {
          div {
            h3.font-serif.text-3xl "Where the water meets the land"
            p.mt-2.text-[#49636a] "Take the scenic route along the water."
          }
          span.text-sm.text-[#49636a] "Coastal walks"
        }
      }
      article.md:col-span-5.md:pt-24 {
        img.aspect-[4/5].w-full.rounded-[1rem].object-cover%"https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1100&q=85"&"A quiet mountain lake surrounded by trees"
        div.mt-5 {
          h3.font-serif.text-3xl "A quieter kind of morning"
          p.mt-2.text-[#49636a] "Find a moment of stillness by the water."
        }
      }
    }
  }
  section#journal.bg-[#cbdde0].px-6.py-20.md:px-12.md:py-28 {
    div.mx-auto.grid.max-w-7xl.gap-10.md:grid-cols-2.md:items-center {
      div {
        p.text-sm.font-semibold "From the journal"
        h2.mt-5.max-w-lg.font-serif.text-5xl.md:text-6xl.leading-tight "Leave space for the unexpected."
        p.mt-6.max-w-md.text-lg.leading-relaxed.text-[#49636a] "The best days don't always need an itinerary. Bring a good book, follow a path, and see where the light takes you."
        a.mt-8.inline-block.border-b.border-[#17343b].pb-2.font-semibold$"#visit" "A note on travelling slowly"
      }
      img.aspect-[4/3].w-full.rounded-[1rem].object-cover%"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=85"&"Sunlight falling across a landscape"
    }
  }
  footer#visit.bg-[#17343b].px-6.py-16.text-white.md:px-12 {
    div.mx-auto.flex.max-w-7xl.flex-col.gap-8.md:flex-row.md:items-end.md:justify-between {
      div {
        p.font-serif.text-4xl "See you by the water."
        p.mt-3.text-[#cbdde0] "A little inspiration for your next escape."
      }
      a.w-fit.rounded-full.border.border-white/70.px-6.py-3.hover:bg-white.hover:text-[#17343b]$"#home" "Back to the top"
    }
  }
}
