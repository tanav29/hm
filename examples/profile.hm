// A responsive profile card
main.min-h-screen.bg-[#eef2ff].flex.items-center.justify-center.p-6 {
  article.bg-white.rounded-2xl.shadow-xl.p-8.max-w-md.w-full {
    img.w-20.h-20.rounded-full%https://i.pravatar.cc/160?img=12&"Portrait of Alex Morgan"
    h1.mt-5.text-2xl.font-bold.text-slate-900 "Alex Morgan"
    p.mt-1.text-indigo-600.font-medium "Product designer"
    p.mt-4.text-slate-600 "I turn complex ideas into simple, useful experiences."
    div.mt-6.flex.gap-3 {
      a.rounded-lg.bg-indigo-600.text-white.px-4.py-2.hover:bg-indigo-700$"mailto:alex@example.com" "Get in touch"
      a.rounded-lg.border.border-slate-300.px-4.py-2.hover:bg-slate-50$"https://example.com" "Portfolio"
    }
  }
}
